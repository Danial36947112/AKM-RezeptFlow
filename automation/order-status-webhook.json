{
  "name": "Order Status Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-status",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "order-status"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WEBHOOK_URL || 'http://backend:3001'}}/webhooks/order-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "demo-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ supplierRef: $json.body.supplierRef, status: $json.body.status, idempotencyKey: $json.body.idempotencyKey }) }}"
      },
      "id": "http",
      "name": "POST Order Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "POST Order Status", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "Wholesaler/delivery status events forwarded to RezeptFlow API."
  }
}
